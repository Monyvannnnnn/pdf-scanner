# ==============================================================================
# Supabase Configuration
# ==============================================================================
# URL of your Supabase Project (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project-id.supabase.co

# Public/Anonymous Key (Safe for frontend clients)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key

# Secret/Service Role Key (Used securely by server backend for full DB access)
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key

# Supabase Auth JWKS Endpoint (for JWT token verification)
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# ==============================================================================
# Google Gemini Vision AI Configuration
# ==============================================================================
# Gemini API Key for Multimodal Vision AP Invoice Extraction
# Obtain from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
